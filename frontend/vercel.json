{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-lovat-psi-46.vercel.app/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://backend-lovat-psi-46.vercel.app/health/:path*"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
